{
  "workFolder": "~/CraftWork",
  "releaseOwner": "storytold",
  "apps": [
    {
      "name": "photocraft",
      "label": "PhotoCraft",
      "use": "Raster photo editing, painting and compositing in layers (Photoshop-style)",
      "guide": "book/src/automation/mcp.md",
      "installDir": "PhotoCraft",
      "exe": "photocraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "session_list", "arguments": {} },
      "readOnlyTools": ["session_list", "doc_inspect", "doc_render_preview", "render_preview", "command_list", "ui_inspect", "ui_screenshot"],
      "live": { "port": 18001, "guiArgs": ["--control", "{port}", "--control-token-file", "{tokenFile}", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"], "attach": ["mcp", "--bridge", "127.0.0.1:{port}", "--control-token-file", "{tokenFile}"] }
    },
    {
      "name": "lightcraft",
      "label": "LightCraft",
      "use": "Photo library and non-destructive raw development (Lightroom-style)",
      "guide": "docs/mcp.md",
      "installDir": "LightCraft",
      "exe": "lightcraft-cli",
      "args": ["mcp", "--compact"],
      "probe": { "tool": "list_controls", "arguments": {} },
      "readOnlyTools": ["command_list", "doc_inspect", "render_preview", "list_commands", "query_photos", "list_controls", "get_develop"],
      "live": { "port": 18002, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--compact", "--connect=127.0.0.1:{port}"] }
    },
    {
      "name": "wordcraft",
      "label": "WordCraft",
      "use": "Word-processor documents: docx, odt, rtf, pdf export (Word-style)",
      "guide": "docs/mcp.md",
      "installDir": "WordCraft",
      "exe": "wordcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "get_text", "arguments": {} },
      "readOnlyTools": ["list_commands", "get_text", "inspect_document", "render_page", "parity", "screenshot", "ui_inspect"],
      "live": { "port": 18003, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "pdfcraft",
      "label": "PdfCraft",
      "use": "Reading, editing, combining, redacting and OCR of PDFs",
      "guide": "docs/mcp.md",
      "installDir": "PdfCraft",
      "exe": "pdfcraft-cli",
      "args": ["mcp", "--compact", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "command_list", "arguments": {} },
      "readOnlyTools": ["doc_info", "page_render", "text_extract", "text_find", "command_list", "doc_inspect", "render_preview", "tool_search"]
    },
    {
      "name": "designcraft",
      "label": "DesignCraft",
      "use": "Page layout and print design (InDesign-style)",
      "guide": "docs/agents.md",
      "installDir": "DesignCraft",
      "exe": "designcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_document", "get_story", "menu_list", "ui_inspect"],
      "live": { "port": 18004, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "gridcraft",
      "label": "GridCraft",
      "use": "Spreadsheets, formulas and charts (Excel-style)",
      "guide": "docs/mcp.md",
      "installDir": "GridCraft",
      "exe": "gridcraft-cli",
      "args": ["mcp"],
      "probe": { "tool": "list_functions", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_workbook", "read_range", "get_cell", "evaluate_formula", "list_functions"],
      "live": { "port": 18005, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "deckcraft",
      "label": "DeckCraft",
      "use": "Presentations and slide shows (PowerPoint-style)",
      "guide": "docs/mcp.md",
      "installDir": "DeckCraft",
      "exe": "deckcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_document", "inspect_slide", "render_slide", "screenshot"],
      "live": { "port": 18006, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "cadcraft",
      "label": "CADCraft",
      "use": "2D computer-aided design and drafting, DXF and DWG (AutoCAD-style)",
      "guide": "docs/mcp.md",
      "installDir": "CADCraft",
      "exe": "cadcraft-cli",
      "args": ["mcp"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_drawing", "query_entities", "find_text"],
      "live": { "port": 18007, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "vectorcraft",
      "label": "VectorCraft",
      "use": "Vector art and illustration (Illustrator-style)",
      "guide": "docs/mcp.md",
      "installDir": "VectorCraft",
      "exe": "vectorcraft-cli",
      "args": ["mcp", "--headless", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "command_list", "arguments": {} },
      "readOnlyTools": ["command_list", "doc_inspect", "render_preview", "ui_inspect", "ui_screenshot", "list_commands", "inspect_document", "inspect_ui"],
      "live": { "port": 18008, "guiArgs": ["--control", "{port}", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "soundcraft",
      "label": "SoundCraft",
      "use": "Multitrack audio recording, editing and mixing (Pro Tools-style)",
      "guide": "docs/mcp.md",
      "installDir": "SoundCraft",
      "exe": "soundcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_session", "parity", "ui_inspect"],
      "live": { "port": 18009, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--connect", "127.0.0.1:{port}"] }
    },
    {
      "name": "filmcraft",
      "label": "FilmCraft",
      "use": "Nonlinear video editing (Premiere-style)",
      "guide": "docs/agents.md",
      "installDir": "FilmCraft",
      "exe": "filmcraft-cli",
      "args": ["mcp"],
      "probe": { "tool": "command_list", "arguments": {} },
      "readOnlyTools": ["command_list", "doc_inspect", "project_inspect", "render_frame", "render_preview", "sequence_inspect", "ui_elements", "ui_inspect", "ui_screenshot"],
      "live": { "port": 18010, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--bridge", "127.0.0.1:{port}"] }
    },
    {
      "name": "effectcraft",
      "label": "EffectCraft",
      "use": "Motion graphics and compositing (After Effects-style)",
      "guide": "docs/agents.md",
      "installDir": "EffectCraft",
      "exe": "effectcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "describe_command", "get_project", "get_comp", "get_layer", "get_property", "list_effects", "list_fonts", "get_state", "command_list", "render_preview", "doc_inspect"],
      "live": { "port": 18011, "guiArgs": ["--control", "{port}"], "attach": ["mcp", "--bridge", "127.0.0.1:{port}"] }
    },
    {
      "name": "figcraft",
      "label": "FigCraft",
      "use": "Interface design and prototyping: frames, components, auto layout (Figma-style)",
      "guide": "docs/mcp.md",
      "installDir": "FigCraft",
      "exe": "figcraft-cli",
      "args": ["mcp", "--automation-read-root", "{workFolder}", "--automation-write-root", "{workFolder}"],
      "probe": { "tool": "list_commands", "arguments": {} },
      "readOnlyTools": ["list_commands", "inspect_document", "get_node", "screenshot", "inspect_ui"]
    }
  ]
}